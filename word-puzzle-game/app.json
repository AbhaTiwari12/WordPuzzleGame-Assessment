{
  "expo": {
    "name": "Word Wheel",
    "slug": "word-wheel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2E1A47"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.wordwheel.game",
      "adaptiveIcon": {
        "backgroundColor": "#2E1A47"
      }
    },
    "ios": {
      "bundleIdentifier": "com.wordwheel.game",
      "supportsTablet": false
    },
    "plugins": ["react-native-reanimated"]
  }
}
